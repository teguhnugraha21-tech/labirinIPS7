        async function initCloudMultiplayer() {
            try {
                if (typeof __firebase_config === 'undefined') return;
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    const cred = await signInWithCustomToken(auth, __initial_auth_token);
                    currentUser = cred.user;
                } else {
                    const cred = await signInAnonymously(auth);
                    currentUser = cred.user;
                }
            } catch (err) {
                console.error("Multiplayer init error:", err);
            }
        }
        initCloudMultiplayer();

        // Create Floating Name Sprite Above Remote Player Heads
        function createPlayerNameSprite(playerName, isWinner = false) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 64;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = isWinner ? 'rgba(245, 158, 11, 0.92)' : 'rgba(15, 23, 42, 0.82)';
            ctx.beginPath();
            ctx.roundRect(16, 10, 224, 44, 22);
            ctx.fill();

            ctx.strokeStyle = isWinner ? '#fef08a' : '#38bdf8';
            ctx.lineWidth = 4;
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 24px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(playerName.slice(0, 16), 128, 33);

            const tex = new THREE.CanvasTexture(canvas);
            const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
            const sprite = new THREE.Sprite(mat);
            sprite.scale.set(2.4, 0.6, 1);
            sprite.position.set(0, 3.35, 0);
            return sprite;
        }

        function cleanupMultiplayerListeners() {
            if (unsubRoomPlayers) { unsubRoomPlayers(); unsubRoomPlayers = null; }
            if (unsubRoomState) { unsubRoomState(); unsubRoomState = null; }
            Object.keys(remotePlayers).forEach(uid => {
                if (remotePlayers[uid].mesh && scene) scene.remove(remotePlayers[uid].mesh);
                delete remotePlayers[uid];
            });
        }

        async function joinMultiplayerRoom() {
            if (!isMultiplayer || !db || !currentUser) return;
            cleanupMultiplayerListeners();

            const uid = currentUser.uid;
            const playersCol = collection(db, 'artifacts', appId, 'public', 'data', `maze_players_${roomCode}`);
            const roomDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'maze_rooms', roomCode);

            // Register self in room
            await setDoc(doc(playersCol, uid), {
                uid: uid,
                name: charConfig.name,
                config: JSON.stringify(charConfig),
                x: playerState.pos.x,
                y: playerState.pos.y,
                z: playerState.pos.z,
                rotY: playerState.rotationY,
                score: 0,
                gatesOpened: 0,
                isHidden: false,
                finished: false,
                updatedAt: Date.now()
            }, { merge: true });

            // Listen to Shared Room State (Co-op Unlocked Gates & Collected Crystals)
            unsubRoomState = onSnapshot(roomDocRef, (snap) => {
                if (!snap.exists()) return;
                const data = snap.data();

                // Sync shared unlocked gates
                if (Array.isArray(data.openedGates)) {
                    let newlyOpened = false;
                    gates.forEach(g => {
                        if (data.openedGates.includes(g.id) && !g.isOpen) {
                            g.isOpen = true;
                            newlyOpened = true;
                        }
                    });
                    if (newlyOpened) {
                        gatesOpenedCount = gates.filter(g => g.isOpen).length;
                        if (gatesOpenedCount >= 10 && finishShieldMesh) {
                            finishShieldMesh.visible = false;
                        }
                        updateHUD();
                    }
                }

                // Sync shared collected crystals
                if (Array.isArray(data.collectedCrystals)) {
                    collectibles.forEach((item, idx) => {
                        if (data.collectedCrystals.includes(idx) && !item.collected) {
                            item.collected = true;
                            item.mesh.visible = false;
                        }
                    });
                }
            }, (err) => console.error("Room state listener error:", err));

            // Listen to All Players in Same Classroom
            unsubRoomPlayers = onSnapshot(playersCol, (snapshot) => {
                const activeIds = new Set();
                const allPlayersList = [];
                const now = Date.now();

                snapshot.forEach(docSnap => {
                    const p = docSnap.data();
                    // Ignore stale disconnected sessions (> 45 seconds inactive)
                    if (now - (p.updatedAt || 0) > 45000 && p.uid !== uid) return;

                    activeIds.add(p.uid);
                    allPlayersList.push(p);

                    if (p.uid === uid) return; // Skip self 3D avatar

                    if (!remotePlayers[p.uid]) {
                        let parsedCfg = charConfig;
                        try { parsedCfg = JSON.parse(p.config); } catch (e) {}
                        const avatarMesh = createBlockyCharacter(parsedCfg);
                        avatarMesh.scale.set(0.68, 0.68, 0.68);
                        const nameSprite = createPlayerNameSprite(p.name || "Teman", p.finished);
                        avatarMesh.add(nameSprite);
                        avatarMesh.position.set(p.x || 0, p.y || 0, p.z || 0);
                        scene.add(avatarMesh);

                        remotePlayers[p.uid] = {
                            mesh: avatarMesh,
                            nameSprite: nameSprite,
                            data: p,
                            targetPos: new THREE.Vector3(p.x || 0, p.y || 0, p.z || 0),
                            targetRotY: p.rotY || 0,
                            walkCycle: 0
                        };
                    } else {
                        const rp = remotePlayers[p.uid];
                        rp.data = p;
                        rp.targetPos.set(p.x || 0, p.y || 0, p.z || 0);
                        rp.targetRotY = p.rotY || 0;
                    }
                });

                // Remove players who left the room
                Object.keys(remotePlayers).forEach(existingUid => {
                    if (!activeIds.has(existingUid)) {
                        scene.remove(remotePlayers[existingUid].mesh);
                        delete remotePlayers[existingUid];
                    }
                });

                // Update Live Classroom Leaderboard UI
                renderMultiplayerLeaderboard(allPlayersList, uid);
            }, (err) => console.error("Players listener error:", err));
        }

        function renderMultiplayerLeaderboard(playersList, selfUid) {
            const countEl = document.getElementById('hud-online-count');
            const listEl = document.getElementById('hud-leaderboard-list');
            if (!countEl || !listEl) return;

            playersList.sort((a, b) => (b.score || 0) - (a.score || 0));
            countEl.textContent = `${playersList.length} Siswa Aktif`;

            listEl.innerHTML = playersList.map((p, i) => {
                const isMe = p.uid === selfUid;
                const statusIcon = p.finished ? '🏆' : (i === 0 ? '👑' : '🧭');
                return `
                    <div class="flex justify-between items-center px-2 py-0.5 rounded ${isMe ? 'bg-sky-500/30 text-sky-200 border border-sky-400/40' : 'bg-white/5 text-slate-200'}">
                        <span class="truncate max-w-[125px]">${statusIcon} ${p.name || 'Siswa'} ${isMe ? '(Kamu)' : ''}</span>
                        <span class="text-amber-300 shrink-0">${p.score || 0} pts</span>
                    </div>
                `;
            }).join('');
        }

        async function syncLocalPlayerToCloud(finished = false) {
            if (!isMultiplayer || !db || !currentUser) return;
            const now = Date.now();
            if (!finished && now - lastSyncTime < 180) return; // Throttle ~5.5 updates/sec
            lastSyncTime = now;

            try {
                const uid = currentUser.uid;
                const playerDocRef = doc(db, 'artifacts', appId, 'public', 'data', `maze_players_${roomCode}`, uid);
                await setDoc(playerDocRef, {
                    uid: uid,
                    name: charConfig.name,
                    x: Number(playerState.pos.x.toFixed(2)),
                    y: Number(playerState.pos.y.toFixed(2)),
                    z: Number(playerState.pos.z.toFixed(2)),
                    rotY: Number(playerState.rotationY.toFixed(2)),
                    score: score,
                    gatesOpened: gatesOpenedCount,
                    isHidden: isPlayerHidden,
                    finished: finished,
                    updatedAt: now
                }, { merge: true });
            } catch (e) {}
        }

        async function syncSharedWorldProgress() {
            if (!isMultiplayer || !db || !currentUser) return;
            try {
                const roomDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'maze_rooms', roomCode);
                const openedGates = gates.filter(g => g.isOpen).map(g => g.id);
                const collectedCrystals = collectibles.map((c, i) => c.collected ? i : -1).filter(i => i !== -1);
                await setDoc(roomDocRef, {
                    openedGates: openedGates,
                    collectedCrystals: collectedCrystals,
                    updatedAt: Date.now()
                }, { merge: true });
            } catch (e) {}
        }

        function updateRemotePlayers(dt) {
            Object.values(remotePlayers).forEach(rp => {
                const moveDist = rp.mesh.position.distanceTo(rp.targetPos);
                rp.mesh.position.lerp(rp.targetPos, Math.min(1, dt * 12));

                let diff = rp.targetRotY - rp.mesh.rotation.y;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;
                rp.mesh.rotation.y += diff * Math.min(1, dt * 12);

                if (moveDist > 0.04) {
                    rp.walkCycle += dt * 14;
                    const swing = Math.sin(rp.walkCycle) * 0.6;
                    rp.mesh.userData.leftLeg.rotation.x = swing;
                    rp.mesh.userData.rightLeg.rotation.x = -swing;
                    rp.mesh.userData.leftArm.rotation.x = -swing * 0.8;
                    rp.mesh.userData.rightArm.rotation.x = swing * 0.8;
                } else {
                    rp.mesh.userData.leftLeg.rotation.x *= 0.8;
                    rp.mesh.userData.rightLeg.rotation.x *= 0.8;
                    rp.mesh.userData.leftArm.rotation.x *= 0.8;
                    rp.mesh.userData.rightArm.rotation.x *= 0.8;
                }
            });
        }

        /**
         * ============================================================================
