        let previewScene, previewCamera, previewRenderer, previewCharMesh;
        let previewAngle = 0.4;
        let isDraggingPreview = false;
        let prevMouseX = 0;

        function initPreviewScene() {
            const container = document.getElementById('preview-canvas-container');
            previewScene = new THREE.Scene();

            previewCamera = new THREE.PerspectiveCamera(42, container.clientWidth / container.clientHeight, 0.1, 100);
            previewCamera.position.set(0, 2.0, 5.2);
            previewCamera.lookAt(0, 1.45, 0);

            previewRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            previewRenderer.setSize(container.clientWidth, container.clientHeight);
            previewRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(previewRenderer.domElement);

            // Lights
            const hemiLight = new THREE.HemisphereLight(0xffffff, 0x334155, 1.1);
            previewScene.add(hemiLight);
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(4, 8, 5);
            previewScene.add(dirLight);

            // Pedestal Block (Roblox Stud Platform)
            const baseGeo = new THREE.CylinderGeometry(1.4, 1.5, 0.3, 16);
            const baseMat = new THREE.MeshLambertMaterial({ color: 0x10b981 });
            const base = new THREE.Mesh(baseGeo, baseMat);
            base.position.y = -0.15;
            previewScene.add(base);

            rebuildPreviewCharacter();

            // Drag to rotate preview character
            const dom = previewRenderer.domElement;
            dom.addEventListener('mousedown', (e) => { isDraggingPreview = true; prevMouseX = e.clientX; });
            window.addEventListener('mouseup', () => { isDraggingPreview = false; });
            window.addEventListener('mousemove', (e) => {
                if (!isDraggingPreview) return;
                previewAngle += (e.clientX - prevMouseX) * 0.015;
                prevMouseX = e.clientX;
            });

            dom.addEventListener('touchstart', (e) => {
                isDraggingPreview = true;
                prevMouseX = e.touches[0].clientX;
            }, { passive: true });
            window.addEventListener('touchend', () => { isDraggingPreview = false; });
            window.addEventListener('touchmove', (e) => {
                if (!isDraggingPreview) return;
                previewAngle += (e.touches[0].clientX - prevMouseX) * 0.015;
                prevMouseX = e.touches[0].clientX;
            }, { passive: true });
        }

        function rebuildPreviewCharacter() {
            if (previewCharMesh) previewScene.remove(previewCharMesh);
            previewCharMesh = createBlockyCharacter(charConfig);
            previewScene.add(previewCharMesh);
        }

