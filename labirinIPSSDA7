            const dirLight = new THREE.DirectionalLight(0xfffbeb, 0.95);
            dirLight.position.set(35, 65, 35);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 2048;
            dirLight.shadow.mapSize.height = 2048;
            dirLight.shadow.camera.near = 10;
            dirLight.shadow.camera.far = 150;
            const d = 55;
            dirLight.shadow.camera.left = -d;
            dirLight.shadow.camera.right = d;
            dirLight.shadow.camera.top = d;
            dirLight.shadow.camera.bottom = -d;
            scene.add(dirLight);

            // Floor & Wall Textures
            const grassTex = createStudTexture('#22c55e', '#4ade80');
            grassTex.repeat.set(28, 36);
            const floorGeo = new THREE.PlaneGeometry(180, 220);
            const floorMat = new THREE.MeshLambertMaterial({ map: grassTex });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.position.set(32, 0, 45);
            floor.receiveShadow = true;
            scene.add(floor);

            const wallTex = createStudTexture('#475569', '#64748b');
            const wallMat = new THREE.MeshLambertMaterial({ map: wallTex });
            const hedgeTopTex = createStudTexture('#15803d', '#22c55e');
            const hedgeMat = new THREE.MeshLambertMaterial({ map: hedgeTopTex });

            const rows = MAZE_GRID.length;
            const cols = MAZE_GRID[0].length;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const cell = MAZE_GRID[r][c];
                    const wx = c * CELL_SIZE;
                    const wz = r * CELL_SIZE;

                    if (cell === 1) {
                        const wallGeo = new THREE.BoxGeometry(CELL_SIZE, WALL_HEIGHT, CELL_SIZE);
                        const wallMesh = new THREE.Mesh(wallGeo, wallMat);
                        wallMesh.position.set(wx, WALL_HEIGHT / 2, wz);
                        wallMesh.castShadow = true;
                        wallMesh.receiveShadow = true;
                        scene.add(wallMesh);

                        const capGeo = new THREE.BoxGeometry(CELL_SIZE + 0.12, 0.4, CELL_SIZE + 0.12);
                        const capMesh = new THREE.Mesh(capGeo, hedgeMat);
                        capMesh.position.set(wx, WALL_HEIGHT + 0.2, wz);
                        scene.add(capMesh);

                        const box = new THREE.Box3().setFromCenterAndSize(
                            new THREE.Vector3(wx, WALL_HEIGHT / 2, wz),
                            new THREE.Vector3(CELL_SIZE, WALL_HEIGHT, CELL_SIZE)
                        );
                        wallColliders.push(box);

                    } else if (cell === 'S') {
                        playerState.pos.set(wx, 0, wz);
                        safeCheckpoint.set(wx, 0, wz);
                        const pad = new THREE.Mesh(
                            new THREE.CylinderGeometry(1.7, 1.9, 0.14, 16),
                            new THREE.MeshLambertMaterial({ color: 0x38bdf8 })
                        );
                        pad.position.set(wx, 0.07, wz);
                        scene.add(pad);

                    } else if (typeof cell === 'string' && cell.startsWith('G')) {
                        createGate(cell, wx, wz, r, c);

                    } else if (cell === 'C') {
                        createCollectible(wx, wz, r, c);

                    } else if (cell === 'H') {
                        createHidingSpot(wx, wz, r, c);

                    } else if (cell === 'T') {
                        createSpikeTrap(wx, wz, r, c);

                    } else if (cell === 'L') {
                        createLavaTrap(wx, wz, r, c);

                    } else if (cell === 'M') {
                        createMonster(wx, wz, r, c, false);

                    } else if (cell === 'MG') {
                        createMonster(wx, wz, r, c, true);

                    } else if (cell === 'F') {
                        createFinishMonument(wx, wz);
                    }
                }
            }

            totalCrystals = collectibles.length;
            setupGameControls();
        }

        // Create Locked Quiz Gate with 3D Frame, Sliding Door & Floating Number Sign
        function createGate(gateId, wx, wz, r, c) {
            const info = GATE_TOPICS[gateId];
            const gateGroup = new THREE.Group();
            gateGroup.position.set(wx, 0, wz);

            const frameMat = new THREE.MeshLambertMaterial({ color: 0x1e293b });
            const leftPillar = new THREE.Mesh(new THREE.BoxGeometry(0.65, WALL_HEIGHT, 0.9), frameMat);
            leftPillar.position.set(-CELL_SIZE / 2 + 0.35, WALL_HEIGHT / 2, 0);
            const rightPillar = new THREE.Mesh(new THREE.BoxGeometry(0.65, WALL_HEIGHT, 0.9), frameMat);
            rightPillar.position.set(CELL_SIZE / 2 - 0.35, WALL_HEIGHT / 2, 0);
            const topBeam = new THREE.Mesh(new THREE.BoxGeometry(CELL_SIZE, 0.65, 0.9), frameMat);
            topBeam.position.set(0, WALL_HEIGHT - 0.32, 0);
            gateGroup.add(leftPillar, rightPillar, topBeam);

            // Door Mesh (Slides up when unlocked)
            const doorMat = new THREE.MeshLambertMaterial({ color: info.color });
            const doorMesh = new THREE.Mesh(new THREE.BoxGeometry(CELL_SIZE - 1.2, WALL_HEIGHT - 0.65, 0.42), doorMat);
            doorMesh.position.set(0, (WALL_HEIGHT - 0.65) / 2, 0);
            doorMesh.castShadow = true;
            gateGroup.add(doorMesh);

            // Signboard with Gate Number
            const signCanvas = document.createElement('canvas');
            signCanvas.width = 256;
            signCanvas.height = 128;
            const sctx = signCanvas.getContext('2d');
            sctx.fillStyle = '#fef08a';
            sctx.fillRect(0, 0, 256, 128);
            sctx.strokeStyle = '#b45309';
            sctx.lineWidth = 10;
            sctx.strokeRect(5, 5, 246, 118);
            sctx.fillStyle = '#1e293b';
            sctx.font = 'bold 42px sans-serif';
            sctx.textAlign = 'center';
            sctx.fillText(`GERBANG ${info.num}`, 128, 56);
            sctx.font = 'bold 26px sans-serif';
            sctx.fillStyle = '#dc2626';
            sctx.fillText('🔒 JAWAB KUIS', 128, 98);

            const signTex = new THREE.CanvasTexture(signCanvas);
            const signMat = new THREE.MeshBasicMaterial({ map: signTex });
            const signBoard = new THREE.Mesh(new THREE.BoxGeometry(2.5, 1.15, 0.16), signMat);
            signBoard.position.set(0, WALL_HEIGHT + 0.7, 0);
            gateGroup.add(signBoard);

            scene.add(gateGroup);

            const collider = new THREE.Box3().setFromCenterAndSize(
                new THREE.Vector3(wx, WALL_HEIGHT / 2, wz),
                new THREE.Vector3(CELL_SIZE, WALL_HEIGHT, CELL_SIZE * 0.7)
            );

            gates.push({
                id: gateId,
                num: info.num,
                topic: info.topic,
                pos: new THREE.Vector3(wx, 0, wz),
                r: r,
                c: c,
                doorMesh: doorMesh,
                collider: collider,
                isOpen: false,
                openProgress: 0
            });
        }

