        /**
         * ============================================================================
         * 9. PLAYER MOVEMENT, TRAPS, MONSTERS, HIDING & 2D INSERT MAP
         * ============================================================================
         */
        function checkCollision(nextPos, radius = 0.52) {
            const playerBox = new THREE.Box3(
                new THREE.Vector3(nextPos.x - radius, 0.1, nextPos.z - radius),
                new THREE.Vector3(nextPos.x + radius, 2.2, nextPos.z + radius)
            );

            for (let box of wallColliders) {
                if (playerBox.intersectsBox(box)) return true;
            }
            for (let g of gates) {
                if (!g.isOpen && playerBox.intersectsBox(g.collider)) return true;
            }
            return false;
        }

        function damagePlayer(reasonText) {
            if (invulnerableTimer > 0 || !isGameRunning) return;
            sfx.playHurt();
            lives--;
            invulnerableTimer = 2.2;

            // Red flash screen effect
            const vig = document.getElementById('screen-vignette');
            vig.style.opacity = '1';
            setTimeout(() => { vig.style.opacity = '0'; }, 350);

            updateHUD();

            if (lives <= 0) {
                triggerGameOver(reasonText);
            } else {
                // Respawn player at last safe checkpoint
                playerState.pos.copy(safeCheckpoint);
                playerState.velY = 0;
            }
        }

        function updateTrapsAndCollectibles(dt, elapsed) {
            // 1. Collectibles (SDA Crystals: 15 crystals x 20 pts = 300 pts)
            for (let item of collectibles) {
                if (item.collected) continue;
                item.gem.rotation.y += dt * 2.4;
                item.gem.position.y = Math.sin(elapsed * 3.5 + item.r) * 0.16;

                if (playerState.pos.distanceTo(item.pos) < 1.5) {
                    item.collected = true;
                    item.mesh.visible = false;
                    crystalsCollected++;
                    score += 20;
                    sfx.playCoin();
                    updateHUD();
                    syncSharedWorldProgress();
                }
            }

            // 2. Floor Traps (Periodic Spikes & Lava)
            for (let t of traps) {
                if (t.type === 'spikes') {
                    const cycle = Math.sin(elapsed * 2.4 + t.phase);
                    t.isActive = cycle > 0.25;
                    const targetY = t.isActive ? 0 : -0.95;
                    t.spikesGroup.position.y += (targetY - t.spikesGroup.position.y) * 12 * dt;
                } else if (t.type === 'lava') {
                    t.mesh.material.color.setHex(Math.sin(elapsed * 5) > 0 ? 0xf97316 : 0xef4444);
                }

                if (t.isActive && playerState.pos.y < 0.6 && playerState.pos.distanceTo(t.pos) < 1.45) {
                    damagePlayer(t.type === 'lava' ? "Kamu terjatuh ke dalam kolam lava panas!" : "Kamu terkena jebakan duri tajam di lantai!");
                }
            }
        }

        function updateMonsters(dt) {
            let anyChasing = false;

            for (let m of monsters) {
                const distToPlayer = m.pos.distanceTo(playerState.pos);
                const detectRange = m.isGoldGuardian ? 11.5 : 11.0;

                // Monster detects player ONLY if player is NOT hidden in a bush/shelter
                if (!isPlayerHidden && distToPlayer < detectRange) {
                    if (!m.isChasing) {
                        sfx.playMonsterAlert();
                    }
                    m.isChasing = true;
                    anyChasing = true;
                } else if (isPlayerHidden || distToPlayer > 15.0) {
                    m.isChasing = false;
                }

                // Gold Guardian stays near the Gold zone unless chasing closely
                if (m.isGoldGuardian && m.pos.distanceTo(m.spawnPos) > 13.0) {
                    m.isChasing = false;
                }

                const speed = m.isChasing ? (m.isGoldGuardian ? 7.5 : 7.0) : 3.2;

                if (m.isChasing) {
                    const toPlayer = new THREE.Vector3().subVectors(playerState.pos, m.pos);
                    toPlayer.y = 0;
                    if (toPlayer.length() > 0.1) toPlayer.normalize();

                    const nextX = m.pos.clone();
                    nextX.x += toPlayer.x * speed * dt;
                    if (!checkCollision(nextX, 0.5)) m.pos.x = nextX.x;

                    const nextZ = m.pos.clone();
                    nextZ.z += toPlayer.z * speed * dt;
                    if (!checkCollision(nextZ, 0.5)) m.pos.z = nextZ.z;

                    m.dir.copy(toPlayer);
                } else if (m.isGoldGuardian && m.pos.distanceTo(m.spawnPos) > 4.5) {
                    // Gold Guardian returns to guard the Final Gold
                    const toHome = new THREE.Vector3().subVectors(m.spawnPos, m.pos).normalize();
                    const nextPos = m.pos.clone().addScaledVector(toHome, speed * dt);
                    if (!checkCollision(nextPos, 0.5)) m.pos.copy(nextPos);
                    m.dir.copy(toHome);
                } else {
                    // Patrol corridors
                    const nextPos = m.pos.clone().addScaledVector(m.dir, speed * dt);
                    if (!checkCollision(nextPos, 0.5)) {
                        m.pos.copy(nextPos);
                    } else {
                        const dirs = [
                            new THREE.Vector3(1, 0, 0),
                            new THREE.Vector3(-1, 0, 0),
                            new THREE.Vector3(0, 0, 1),
                            new THREE.Vector3(0, 0, -1)
                        ];
                        const validDirs = dirs.filter(d => !checkCollision(m.pos.clone().addScaledVector(d, 1.0), 0.5));
                        if (validDirs.length > 0) {
                            m.dir = validDirs[Math.floor(Math.random() * validDirs.length)];
                        } else {
                            m.dir.negate();
                        }
                    }
                }

                // Update Monster Mesh Transform & Animation
                m.mesh.position.copy(m.pos);
                m.mesh.rotation.y = Math.atan2(m.dir.x, m.dir.z);
                m.walkCycle += dt * (m.isChasing ? 15 : 7);
                m.mesh.position.y = Math.abs(Math.sin(m.walkCycle)) * 0.18;
                m.armL.rotation.x = -0.5 + Math.sin(m.walkCycle) * 0.35;
                m.armR.rotation.x = -0.5 - Math.sin(m.walkCycle) * 0.35;

                // Check if Monster catches/eats Player
                if (!isPlayerHidden && m.pos.distanceTo(playerState.pos) < 1.2) {
                    damagePlayer(m.isGoldGuardian
                        ? "Kamu tertangkap oleh Monster Penjaga Emas Utama!"
                        : "Kamu tertangkap dan dimakan oleh Monster Penjaga Labirin!");
                }
            }

            isBeingChased = anyChasing;
            const chaseEl = document.getElementById('chase-warning');
            const vigEl = document.getElementById('screen-vignette');
            if (isBeingChased) {
                chaseEl.classList.remove('hidden');
                vigEl.classList.add('danger-vignette');
                vigEl.style.opacity = '1';
            } else {
                chaseEl.classList.add('hidden');
                vigEl.classList.remove('danger-vignette');
                if (invulnerableTimer <= 0) vigEl.style.opacity = '0';
            }
        }

        function updatePlayer(dt) {
            if (!isGameRunning || isQuizOpen || !playerMesh) return;

            if (invulnerableTimer > 0) {
                invulnerableTimer -= dt;
                playerMesh.visible = Math.floor(invulnerableTimer * 12) % 2 === 0;
            } else {
                playerMesh.visible = !isFirstPerson;
            }

            // Movement Input Vector
            let moveForward = 0;
            let moveRight = 0;

            if (keys['KeyW'] || keys['ArrowUp']) moveForward += 1;
            if (keys['KeyS'] || keys['ArrowDown']) moveForward -= 1;
            if (keys['KeyD'] || keys['ArrowRight']) moveRight += 1;
            if (keys['KeyA'] || keys['ArrowLeft']) moveRight -= 1;

            if (Math.abs(joyVector.x) > 0.1 || Math.abs(joyVector.y) > 0.1) {
                moveForward = -joyVector.y;
                moveRight = joyVector.x;
            }

            const inputLen = Math.hypot(moveForward, moveRight);
            const wantsSprint = (keys['ShiftLeft'] || keys['ShiftRight'] || mobileSprintActive) && inputLen > 0.1;

            if (wantsSprint && playerState.stamina > 2) {
                playerState.isSprinting = true;
                playerState.stamina = Math.max(0, playerState.stamina - 32 * dt);
            } else {
                playerState.isSprinting = false;
                playerState.stamina = Math.min(100, playerState.stamina + 20 * dt);
            }

            const baseSpeed = 8.4;
            const speed = playerState.isSprinting ? 13.5 : baseSpeed;

            if (inputLen > 0.05) {
                const normF = moveForward / Math.max(1, inputLen);
                const normR = moveRight / Math.max(1, inputLen);

                const forwardDir = new THREE.Vector3(-Math.sin(cameraYaw), 0, -Math.cos(cameraYaw));
                const rightDir = new THREE.Vector3(Math.cos(cameraYaw), 0, -Math.sin(cameraYaw));

                const moveVec = new THREE.Vector3()
                    .addScaledVector(forwardDir, normF)
                    .addScaledVector(rightDir, normR)
                    .normalize();

                const stepDist = speed * dt;

                const tryX = playerState.pos.clone();
                tryX.x += moveVec.x * stepDist;
                if (!checkCollision(tryX)) {
                    playerState.pos.x = tryX.x;
                }

                const tryZ = playerState.pos.clone();
                tryZ.z += moveVec.z * stepDist;
                if (!checkCollision(tryZ)) {
                    playerState.pos.z = tryZ.z;
                }

                const targetRot = Math.atan2(moveVec.x, moveVec.z);
                let diff = targetRot - playerState.rotationY;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;
                playerState.rotationY += diff * 12 * dt;

                playerState.walkCycle += dt * (playerState.isSprinting ? 18 : 12);
                const swing = Math.sin(playerState.walkCycle) * 0.65;
                playerMesh.userData.leftLeg.rotation.x = swing;
                playerMesh.userData.rightLeg.rotation.x = -swing;
                playerMesh.userData.leftArm.rotation.x = -swing * 0.85;
                playerMesh.userData.rightArm.rotation.x = swing * 0.85;

                playerState.stepTimer += dt;
                if (playerState.stepTimer > (playerState.isSprinting ? 0.24 : 0.36) && playerState.isGrounded) {
                    sfx.playStep();
                    playerState.stepTimer = 0;
                }
            } else {
                playerMesh.userData.leftLeg.rotation.x *= 0.8;
                playerMesh.userData.rightLeg.rotation.x *= 0.8;
                playerMesh.userData.leftArm.rotation.x *= 0.8;
                playerMesh.userData.rightArm.rotation.x *= 0.8;
            }

            // Gravity & Jump
            playerState.velY -= 26 * dt;
            playerState.pos.y += playerState.velY * dt;
            if (playerState.pos.y <= 0) {
                playerState.pos.y = 0;
                playerState.velY = 0;
                playerState.isGrounded = true;
            }

            // Check Hiding Spot (Safe Shelter)
            let insideHiding = false;
            for (let h of hidingSpots) {
                if (playerState.pos.distanceTo(h.pos) < h.radius) {
                    insideHiding = true;
                    break;
                }
            }
            isPlayerHidden = insideHiding;
            const stealthEl = document.getElementById('stealth-badge');
            if (isPlayerHidden) {
                stealthEl.classList.remove('hidden');
                playerMesh.scale.set(0.75, 0.55, 0.75); // Crouch inside shelter
            } else {
                stealthEl.classList.add('hidden');
                playerMesh.scale.set(0.68, 0.68, 0.68); // Compact Roblox character scale
            }

            playerMesh.position.copy(playerState.pos);
            playerMesh.rotation.y = playerState.rotationY;

            // Check Proximity to Closed Gates
            let nearestClosedGate = null;
            let minGateDist = 3.8;
            for (let g of gates) {
                if (!g.isOpen) {
                    const dist = playerState.pos.distanceTo(g.pos);
                    if (dist < minGateDist) {
                        minGateDist = dist;
                        nearestClosedGate = g;
                    }
                }
            }

            activeGate = nearestClosedGate;
            const promptEl = document.getElementById('gate-prompt');
            const mobileInteract = document.getElementById('mobile-interact-btn');
            if (activeGate) {
                promptEl.classList.remove('hidden');
                mobileInteract.classList.remove('hidden');
            } else {
                promptEl.classList.add('hidden');
                mobileInteract.classList.add('hidden');
            }

            // Check Final Gold Reached (Requires all 10 Gates answered correctly!)
            const goldLockEl = document.getElementById('gold-locked-msg');
            if (playerState.pos.distanceTo(finishPos) < 2.4) {
                if (gatesOpenedCount >= 10) {
                    goldLockEl.classList.add('hidden');
                    triggerVictory();
                } else {
                    goldLockEl.classList.remove('hidden');
                }
            } else {
                goldLockEl.classList.add('hidden');
            }
        }

        function updateCamera() {
            if (!playerMesh) return;
            if (isFirstPerson) {
                camera.position.set(playerState.pos.x, playerState.pos.y + 1.65, playerState.pos.z);
                const lookTarget = new THREE.Vector3(
                    camera.position.x - Math.sin(cameraYaw) * 10,
                    camera.position.y - Math.sin(cameraPitch - 0.35) * 10,
                    camera.position.z - Math.cos(cameraYaw) * 10
                );
                camera.lookAt(lookTarget);
            } else {
                // Slightly pulled-back camera so Roblox character appears compact & spacious
                const camDist = 9.8;
                const horizontalDist = camDist * Math.cos(cameraPitch);
                const verticalDist = camDist * Math.sin(cameraPitch) + 2.4;

                const idealX = playerState.pos.x + Math.sin(cameraYaw) * horizontalDist;
                const idealZ = playerState.pos.z + Math.cos(cameraYaw) * horizontalDist;
                const idealY = playerState.pos.y + verticalDist;

                camera.position.lerp(new THREE.Vector3(idealX, idealY, idealZ), 0.18);
                camera.lookAt(playerState.pos.x, playerState.pos.y + 1.15, playerState.pos.z);
            }
        }

        function drawMiniMap() {
            const canvas = document.getElementById('minimap-canvas');
            const ctx = canvas.getContext('2d');
            const rows = MAZE_GRID.length;
            const cols = MAZE_GRID[0].length;
            const cellW = canvas.width / cols;
            const cellH = canvas.height / rows;

            // Maze Pathways Background
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const cell = MAZE_GRID[r][c];
                    if (cell === 1) {
                        ctx.fillStyle = '#64748b';
                        ctx.fillRect(c * cellW, r * cellH, cellW + 0.5, cellH + 0.5);
                    } else if (cell === 'F') {
                        ctx.fillStyle = '#fde047';
                        ctx.fillRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);
                    }
                }
            }

            // Draw Hiding Spots (Green Safe Zones)
            for (let h of hidingSpots) {
                ctx.fillStyle = '#10b981';
                ctx.fillRect(h.c * cellW + 2, h.r * cellH + 2, cellW - 4, cellH - 4);
            }

            // Draw Uncollected Point Crystals (Gold Dots)
            for (let item of collectibles) {
                if (!item.collected) {
                    ctx.fillStyle = '#fbbf24';
                    ctx.beginPath();
                    ctx.arc((item.c + 0.5) * cellW, (item.r + 0.5) * cellH, Math.max(2, cellW * 0.2), 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            // Draw Gates
            for (let g of gates) {
                ctx.fillStyle = g.isOpen ? '#22c55e' : '#f43f5e';
                ctx.fillRect(g.c * cellW + 1, g.r * cellH + 1, cellW - 2, cellH - 2);
            }

            // Draw Moving Monsters (Red Pulsing Dots)
            for (let m of monsters) {
                const mx = (m.pos.x / CELL_SIZE + 0.5) * cellW;
                const mz = (m.pos.z / CELL_SIZE + 0.5) * cellH;
                ctx.fillStyle = '#ef4444';
                ctx.beginPath();
                ctx.arc(mx, mz, Math.max(3, cellW * 0.34), 0, Math.PI * 2);
                ctx.fill();
            }

            // Draw Classmates in Multiplayer Mode (Purple Dots)
            Object.values(remotePlayers).forEach(rp => {
                const rx = (rp.mesh.position.x / CELL_SIZE + 0.5) * cellW;
                const rz = (rp.mesh.position.z / CELL_SIZE + 0.5) * cellH;
                ctx.fillStyle = '#c084fc';
                ctx.beginPath();
                ctx.arc(rx, rz, Math.max(3.2, cellW * 0.34), 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 1;
                ctx.stroke();
            });

            // Draw Player Arrow / Dot
            const px = (playerState.pos.x / CELL_SIZE + 0.5) * cellW;
            const pz = (playerState.pos.z / CELL_SIZE + 0.5) * cellH;
            ctx.fillStyle = '#38bdf8';
            ctx.beginPath();
            ctx.arc(px, pz, Math.max(3.5, cellW * 0.38), 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.stroke();
        }

        /**
         * ============================================================================
         * 10. GAME LIFECYCLE (RULES SCREEN, HUD, TIME + SCORE GRADE, VICTORY & GAME OVER)
         * ============================================================================
         */
        function getTimeBonus(seconds) {
            // Under 3 mins (180s) -> 100 bonus pts; decreases gradually up to 10 mins (600s)
            if (seconds <= 180) return 100;
            if (seconds >= 600) return 20;
            return Math.round(100 - ((seconds - 180) / 420) * 80);
        }

        function calculateGrade(currentScore, seconds = elapsedSeconds) {
            // Max base score = 600 (10 gates * 60) + 300 (15 crystals * 20) = 900 pts + 100 time bonus = 1000 pts
            const timeBonus = getTimeBonus(seconds);
            const totalWithTime = currentScore + timeBonus;
            const numericGrade = Math.min(100, Math.round((totalWithTime / 1000) * 100));
            let letter = 'D';
            if (numericGrade >= 88) letter = 'A';
            else if (numericGrade >= 75) letter = 'B';
            else if (numericGrade >= 60) letter = 'C';
            return { numericGrade, letter, timeBonus, totalWithTime };
        }

        function updateHUD() {
            document.getElementById('hud-player-name').textContent = charConfig.name;
            document.getElementById('hud-gates').textContent = `${gatesOpenedCount}/10`;
            document.getElementById('hud-crystals').textContent = `${crystalsCollected}/${totalCrystals}`;
            document.getElementById('hud-score').textContent = score;

            const { numericGrade, letter } = calculateGrade(score, elapsedSeconds);
            document.getElementById('hud-grade').textContent = `${numericGrade} (${letter})`;

            // Hearts display
            let heartsStr = '';
            for (let i = 0; i < 3; i++) {
                heartsStr += i < lives ? '❤️' : '🖤';
            }
            document.getElementById('hud-lives').textContent = heartsStr;

            // Stamina Bar
            const stamPct = Math.round(playerState.stamina);
            document.getElementById('hud-stamina-text').textContent = `${stamPct}%`;
            document.getElementById('hud-stamina-bar').style.width = `${stamPct}%`;

            const mins = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
            const secs = String(elapsedSeconds % 60).padStart(2, '0');
            document.getElementById('hud-timer').textContent = `${mins}:${secs}`;
        }

        function startGame() {
            sfx.init();
            sfx.playCorrect();

            if (playerMesh) scene.remove(playerMesh);
            playerMesh = createBlockyCharacter(charConfig);
            playerMesh.scale.set(0.68, 0.68, 0.68);
            scene.add(playerMesh);

            // Reset Player & Checkpoints
            for (let r = 0; r < MAZE_GRID.length; r++) {
                for (let c = 0; c < MAZE_GRID[0].length; c++) {
                    if (MAZE_GRID[r][c] === 'S') {
                        playerState.pos.set(c * CELL_SIZE, 0, r * CELL_SIZE);
                        safeCheckpoint.copy(playerState.pos);
                    }
                }
            }
            playerState.velY = 0;
            playerState.rotationY = 0;
            playerState.stamina = 100;
            cameraYaw = Math.PI;

            // Reset Gates & Gold Barrier
            gates.forEach(g => {
                g.isOpen = false;
                g.openProgress = 0;
                g.doorMesh.position.y = 0;
            });
            if (finishShieldMesh) {
                finishShieldMesh.visible = true;
            }

            // Reset Collectibles
            collectibles.forEach(item => {
                item.collected = false;
                item.mesh.visible = true;
            });

            // Reset Monsters
            monsters.forEach(m => {
                m.pos.copy(m.spawnPos);
                m.isChasing = false;
            });

            score = 0;
            crystalsCollected = 0;
            gatesOpenedCount = 0;
            lives = 3;
            invulnerableTimer = 0;
            elapsedSeconds = 0;
            usedQuestionIndices = {};
            isGameRunning = true;
            isQuizOpen = false;

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('rules-screen').classList.add('hidden');
            document.getElementById('victory-screen').classList.add('hidden');
            document.getElementById('gameover-screen').classList.add('hidden');
            document.getElementById('hud-container').classList.remove('hidden');

            const multiPanel = document.getElementById('hud-multiplayer-panel');
            if (isMultiplayer) {
                roomCode = (document.getElementById('room-code-input').value.trim().toUpperCase()) || "IPS7A";
                document.getElementById('hud-room-code').textContent = roomCode;
                multiPanel.classList.remove('hidden');
                joinMultiplayerRoom();
            } else {
                multiPanel.classList.add('hidden');
                cleanupMultiplayerListeners();
            }

            updateHUD();
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (isGameRunning && !isQuizOpen) {
                    elapsedSeconds++;
                    updateHUD();
                }
            }, 1000);
        }

        function triggerVictory() {
            if (!isGameRunning) return;
            isGameRunning = false;
            clearInterval(timerInterval);
            sfx.playVictory();
            syncLocalPlayerToCloud(true);

            document.getElementById('hud-container').classList.add('hidden');
            document.getElementById('screen-vignette').style.opacity = '0';
            document.getElementById('victory-screen').classList.remove('hidden');

            const { numericGrade, letter, timeBonus, totalWithTime } = calculateGrade(score, elapsedSeconds);
            document.getElementById('vic-player-name').textContent = charConfig.name;
            document.getElementById('vic-score').textContent = totalWithTime;
            document.getElementById('vic-gates').textContent = `${gatesOpenedCount}/10`;
            document.getElementById('vic-crystals').textContent = `${crystalsCollected}/${totalCrystals}`;
            document.getElementById('vic-time').textContent = document.getElementById('hud-timer').textContent;
            document.getElementById('vic-time-bonus-info').textContent = `⏱️ Catatan Waktu ${document.getElementById('hud-timer').textContent} ➔ Bonus Kecepatan: +${timeBonus} Poin`;
            document.getElementById('vic-final-grade').textContent = numericGrade;
            document.getElementById('vic-letter-grade').textContent = `Predikat ${letter}`;

            const badge = document.getElementById('vic-rank-badge');
            if (numericGrade >= 90) {
                badge.textContent = "🌟 Profesor Muda Sumber Daya Alam (Sempurna!)";
            } else if (numericGrade >= 75) {
                badge.textContent = "🏅 Duta Potensi Indonesia Maju";
            } else {
                badge.textContent = "🧭 Penjelajah Tangguh Nusantara";
            }
        }

        function triggerGameOver(reasonText) {
            isGameRunning = false;
            clearInterval(timerInterval);

            document.getElementById('hud-container').classList.add('hidden');
            document.getElementById('screen-vignette').style.opacity = '0';
            document.getElementById('gameover-screen').classList.remove('hidden');

            document.getElementById('gameover-reason').textContent = reasonText;
            document.getElementById('go-score').textContent = score;
            document.getElementById('go-gates').textContent = `${gatesOpenedCount}/10`;
        }

        // Screen Flow Navigation Listeners
        document.getElementById('to-rules-btn').addEventListener('click', () => {
            sfx.init();
            sfx.playStep();
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('rules-screen').classList.remove('hidden');
        });
        document.getElementById('back-to-custom-btn').addEventListener('click', () => {
            document.getElementById('rules-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        });
        document.getElementById('start-game-btn').addEventListener('click', startGame);
        document.getElementById('retry-game-btn').addEventListener('click', startGame);
        document.getElementById('play-again-btn').addEventListener('click', () => {
            document.getElementById('victory-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
            rebuildPreviewCharacter();
        });

        // Main Animation Loop
        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            const dt = Math.min(clock.getDelta(), 0.05);
            const elapsed = clock.elapsedTime;

            if (!isGameRunning && previewRenderer && previewCharMesh) {
                if (!isDraggingPreview) previewAngle += dt * 0.7;
                previewCharMesh.rotation.y = previewAngle;
                previewRenderer.render(previewScene, previewCamera);
            }

            clouds.forEach(c => {
                c.position.x += dt * 1.2;
                if (c.position.x > 100) c.position.x = -25;
            });

            if (finishObject) {
                finishObject.rotation.y += dt * 1.8;
                finishObject.position.y = 2.1 + Math.sin(elapsed * 3) * 0.22;
            }

            gates.forEach(g => {
                if (g.isOpen && g.openProgress < 1) {
                    g.openProgress = Math.min(1, g.openProgress + dt * 1.8);
                    g.doorMesh.position.y = g.openProgress * (WALL_HEIGHT - 0.2);
                }
            });

            if (isGameRunning) {
                if (!isQuizOpen) {
                    updatePlayer(dt);
                    updateTrapsAndCollectibles(dt, elapsed);
                    updateMonsters(dt);
                    updateHUD();
                }
                if (isMultiplayer) {
                    updateRemotePlayers(dt);
                    syncLocalPlayerToCloud(false);
                }
                updateCamera();
                drawMiniMap();
                renderer.render(scene, camera);
            }
        }

        // Responsive Resize
        window.addEventListener('resize', () => {
            if (camera && renderer) {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            }
            const prevContainer = document.getElementById('preview-canvas-container');
            if (previewCamera && previewRenderer && prevContainer.clientWidth > 0) {
                previewCamera.aspect = prevContainer.clientWidth / prevContainer.clientHeight;
                previewCamera.updateProjectionMatrix();
                previewRenderer.setSize(prevContainer.clientWidth, prevContainer.clientHeight);
            }
        });

        // Initialize Everything on Window Load
        window.onload = function () {
            initPreviewScene();
            setupCustomizationUI();
            initGameWorld();
            animate();
        };
    </script>
</body>
</html>
