        /**
         * ============================================================================
         * 7. CONTROLS (KEYBOARD, MOUSE CAMERA, SPRINT & MOBILE JOYSTICK)
         * ============================================================================
         */
        function setupGameControls() {
            window.addEventListener('keydown', (e) => {
                keys[e.code] = true;
                if (e.code === 'Space' && isGameRunning && !isQuizOpen && playerState.isGrounded) {
                    playerState.velY = 10.5;
                    playerState.isGrounded = false;
                    sfx.playJump();
                }
                if (e.code === 'KeyE' && isGameRunning && !isQuizOpen && activeGate && !activeGate.isOpen) {
                    openGateQuiz(activeGate);
                }
            });
            window.addEventListener('keyup', (e) => {
                keys[e.code] = false;
            });

            // Mobile Sprint Button (Hold to Sprint)
            const sprintBtn = document.getElementById('mobile-sprint-btn');
            sprintBtn.addEventListener('touchstart', (e) => { e.preventDefault(); mobileSprintActive = true; }, { passive: false });
            sprintBtn.addEventListener('touchend', () => { mobileSprintActive = false; });
            sprintBtn.addEventListener('mousedown', () => { mobileSprintActive = true; });
            sprintBtn.addEventListener('mouseup', () => { mobileSprintActive = false; });

            // Expand / Collapse 2D Insert Map Button
            document.getElementById('expand-map-btn').addEventListener('click', (e) => {
                isMapExpanded = !isMapExpanded;
                const mapCanvas = document.getElementById('minimap-canvas');
                if (isMapExpanded) {
                    mapCanvas.width = 240;
                    mapCanvas.height = 336;
                    e.currentTarget.innerHTML = '<span>🗺️</span> <span>Perkecil Peta</span>';
                } else {
                    mapCanvas.width = 150;
                    mapCanvas.height = 210;
                    e.currentTarget.innerHTML = '<span>🗺️</span> <span class="hidden sm:inline">Perbesar Peta</span>';
                }
            });
            window.addEventListener('keyup', (e) => {
                keys[e.code] = false;
            });

            // Camera Orbit (Mouse & Touch on Canvas)
            const canvas = document.getElementById('game-canvas');
            let isRotatingCam = false;
            let lastCamX = 0;
            let lastCamY = 0;

            canvas.addEventListener('mousedown', (e) => {
                if (!isGameRunning || isQuizOpen) return;
                isRotatingCam = true;
                lastCamX = e.clientX;
                lastCamY = e.clientY;
            });
            window.addEventListener('mouseup', () => { isRotatingCam = false; });
            window.addEventListener('mousemove', (e) => {
                if (!isRotatingCam) return;
                const dx = e.clientX - lastCamX;
                const dy = e.clientY - lastCamY;
                cameraYaw -= dx * 0.007;
                cameraPitch = Math.max(0.08, Math.min(1.1, cameraPitch + dy * 0.005));
                lastCamX = e.clientX;
                lastCamY = e.clientY;
            });

            // Touch Camera Rotation (Right side of screen)
            let camTouchId = null;
            canvas.addEventListener('touchstart', (e) => {
                if (!isGameRunning || isQuizOpen) return;
                for (let t of e.changedTouches) {
                    if (camTouchId === null) {
                        camTouchId = t.identifier;
                        lastCamX = t.clientX;
                        lastCamY = t.clientY;
                    }
                }
            }, { passive: true });
            canvas.addEventListener('touchmove', (e) => {
                if (camTouchId === null) return;
                for (let t of e.changedTouches) {
                    if (t.identifier === camTouchId) {
                        const dx = t.clientX - lastCamX;
                        const dy = t.clientY - lastCamY;
                        cameraYaw -= dx * 0.008;
                        cameraPitch = Math.max(0.08, Math.min(1.1, cameraPitch + dy * 0.006));
                        lastCamX = t.clientX;
                        lastCamY = t.clientY;
                    }
                }
            }, { passive: true });
            canvas.addEventListener('touchend', (e) => {
                for (let t of e.changedTouches) {
                    if (t.identifier === camTouchId) camTouchId = null;
                }
            });

            // Virtual Joystick Logic
            const joyZone = document.getElementById('joystick-zone');
            const joyKnob = document.getElementById('joystick-knob');
            let joyTouchId = null;

            function updateJoystick(clientX, clientY) {
                const rect = joyZone.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                const maxDist = 38;

                let dx = clientX - centerX;
                let dy = clientY - centerY;
                const dist = Math.hypot(dx, dy);
                if (dist > maxDist) {
                    dx = (dx / dist) * maxDist;
                    dy = (dy / dist) * maxDist;
                }
                joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
                joyVector.x = dx / maxDist;
                joyVector.y = dy / maxDist;
            }

            joyZone.addEventListener('touchstart', (e) => {
                e.preventDefault();
                const t = e.changedTouches[0];
                joyTouchId = t.identifier;
                updateJoystick(t.clientX, t.clientY);
            }, { passive: false });

            joyZone.addEventListener('touchmove', (e) => {
                e.preventDefault();
                for (let t of e.changedTouches) {
                    if (t.identifier === joyTouchId) {
                        updateJoystick(t.clientX, t.clientY);
                    }
                }
            }, { passive: false });

            const resetJoystick = () => {
                joyTouchId = null;
                joyKnob.style.transform = `translate(0px, 0px)`;
                joyVector.x = 0;
                joyVector.y = 0;
            };
            joyZone.addEventListener('touchend', resetJoystick);
            joyZone.addEventListener('touchcancel', resetJoystick);

            // Mobile Jump & Interact Buttons
            document.getElementById('mobile-jump-btn').addEventListener('click', () => {
                if (isGameRunning && !isQuizOpen && playerState.isGrounded) {
                    playerState.velY = 11.5;
                    playerState.isGrounded = false;
                    sfx.playJump();
                }
            });

            document.getElementById('mobile-interact-btn').addEventListener('click', () => {
                if (isGameRunning && !isQuizOpen && activeGate && !activeGate.isOpen) {
                    openGateQuiz(activeGate);
                }
            });

            document.getElementById('open-quiz-btn').addEventListener('click', () => {
                if (activeGate && !activeGate.isOpen) {
                    openGateQuiz(activeGate);
                }
            });

            // HUD Buttons
            document.getElementById('toggle-camera-btn').addEventListener('click', () => {
                isFirstPerson = !isFirstPerson;
                if (playerMesh) playerMesh.visible = !isFirstPerson;
            });

            document.getElementById('toggle-sound-btn').addEventListener('click', (e) => {
                sfx.enabled = !sfx.enabled;
