        function getQuestionForTopic(topic) {
            const list = QUESTION_BANK[topic];
            if (!usedQuestionIndices[topic]) usedQuestionIndices[topic] = [];

            let available = list.map((_, idx) => idx).filter(i => !usedQuestionIndices[topic].includes(i));
            if (available.length === 0) {
                usedQuestionIndices[topic] = [];
                available = list.map((_, idx) => idx);
            }
            const chosenIdx = available[Math.floor(Math.random() * available.length)];
            usedQuestionIndices[topic].push(chosenIdx);
            return list[chosenIdx];
        }

        function openGateQuiz(gate) {
            isQuizOpen = true;
            activeGate = gate;
            currentQuestion = getQuestionForTopic(gate.topic);

            const modal = document.getElementById('quiz-modal');
            document.getElementById('quiz-gate-badge').textContent = `GERBANG ${gate.num} DARI 10`;
            document.getElementById('quiz-topic-title').textContent = gate.topic;
            document.getElementById('quiz-question-text').textContent = currentQuestion.q;

            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';

            const feedbackBox = document.getElementById('quiz-feedback');
            feedbackBox.classList.add('hidden');

            const letters = ['A', 'B', 'C', 'D'];
            currentQuestion.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = "w-full text-left p-3.5 rounded-2xl border-2 border-slate-200 hover:border-amber-500 hover:bg-amber-50 font-bold text-slate-700 text-sm md:text-base transition flex items-start gap-3";
                btn.innerHTML = `
                    <span class="bg-slate-200 text-slate-800 font-extrabold w-7 h-7 rounded-lg flex items-center justify-center shrink-0">${letters[idx]}</span>
                    <span>${optText}</span>
                `;
                btn.addEventListener('click', () => handleAnswerSelection(idx, btn));
                optionsContainer.appendChild(btn);
            });

            modal.classList.remove('hidden');
        }

        function handleAnswerSelection(selectedIdx, btnElement) {
            const allButtons = document.querySelectorAll('#quiz-options button');
            allButtons.forEach(b => b.disabled = true);

            const feedbackBox = document.getElementById('quiz-feedback');
            const fbTitle = document.getElementById('quiz-feedback-title');
            const fbDesc = document.getElementById('quiz-feedback-desc');
            const continueBtn = document.getElementById('quiz-continue-btn');

            feedbackBox.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-400', 'text-emerald-900', 'bg-rose-50', 'border-rose-400', 'text-rose-900');

            if (selectedIdx === currentQuestion.answer) {
                // CORRECT ANSWER
                sfx.playCorrect();
                btnElement.classList.remove('border-slate-200');
                btnElement.classList.add('border-emerald-500', 'bg-emerald-100', 'text-emerald-900');

                feedbackBox.classList.add('bg-emerald-50', 'border-emerald-400', 'text-emerald-900');
                fbTitle.textContent = "✅ Jawaban Benar! Gerbang Terbuka!";
                fbDesc.textContent = currentQuestion.explanation;

                continueBtn.textContent = "Lanjutkan Petualangan ➔";
                continueBtn.className = "mt-3 w-full py-2.5 rounded-xl font-bold text-white shadow bg-emerald-600 hover:bg-emerald-500";

                // Update Score & Gate State (60 pts per gate x 10 = 600 pts)
                score += 60;
                gatesOpenedCount++;
                activeGate.isOpen = true;
                safeCheckpoint.copy(activeGate.pos);
                sfx.playGateOpen();

                // Unlock Final Gold Shield if all 10 questions are answered!
