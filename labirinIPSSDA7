         * ============================================================================
         */
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.enabled = true;
            }
            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) this.ctx = new AudioContext();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }
            playTone(freq, type, duration, vol = 0.15, slideFreq = null) {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                if (slideFreq) {
                    osc.frequency.exponentialRampToValueAtTime(slideFreq, this.ctx.currentTime + duration);
                }
                gain.gain.setValueAtTime(vol, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + duration);
            }
            playJump() {
                this.playTone(220, 'sine', 0.22, 0.15, 480);
            }
            playStep() {
                this.playTone(110 + Math.random() * 30, 'triangle', 0.06, 0.05);
            }
            playCorrect() {
                this.playTone(523.25, 'triangle', 0.15, 0.2); // C5
                setTimeout(() => this.playTone(659.25, 'triangle', 0.15, 0.2), 110); // E5
                setTimeout(() => this.playTone(783.99, 'triangle', 0.3, 0.22), 220); // G5
            }
            playWrong() {
                this.playTone(200, 'sawtooth', 0.2, 0.18, 140);
                setTimeout(() => this.playTone(150, 'sawtooth', 0.3, 0.18, 100), 180);
            }
            playGateOpen() {
                this.playTone(180, 'square', 0.5, 0.12, 360);
            }
            playVictory() {
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((n, i) => {
                    setTimeout(() => this.playTone(n, 'triangle', 0.3, 0.22), i * 140);
                });
            }
            playCoin() {
                this.playTone(880, 'sine', 0.1, 0.16);
                setTimeout(() => this.playTone(1174.66, 'sine', 0.18, 0.16), 75);
            }
            playHurt() {
                this.playTone(140, 'sawtooth', 0.35, 0.25, 65);
            }
            playMonsterAlert() {
                this.playTone(110, 'sawtooth', 0.25, 0.18, 95);
            }
        }
